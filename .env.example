# NAC Fuel Management System - Environment Variables Example

# Secret key used for signing JWT authentication tokens. Set to a long, random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Allowed CORS origin for web app requests to the API. Set to your public frontend domain.
CORS_ORIGIN=https://your-domain.example

# Maximum allowed variance percentage for inventory reconciliation threshold (e.g. 0.5 for 0.5%).
MAX_ALLOWED_VARIANCE_PCT=0.5
